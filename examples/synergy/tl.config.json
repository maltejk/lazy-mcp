{
  "mcpProxy": {
    "baseURL": "http://localhost",
    "addr": ":9090",
    "name": "MCP Lazy Load Proxy - Synergy tl",
    "version": "1.0.0",
    "type": "stdio",
    "options": {
      "lazyLoad": true,
      "logFilePath": "/home/agent/Developer/logs/lazy-mcp.log"
    }
  },
  "mcpServers": {
    "context7": {
      "transportType": "streamable-http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "git_tl": {
      "command": "bun",
      "args": [ "--cwd=/home/agent/Developer/git-mcp-server", "run", "dist/index.js" ],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_LOG_LEVEL": "info",
        "GIT_BASE_DIR": "~/Developer/",
        "LOGS_DIR": "/home/agent/Developer/logs/git-mcp-server/",
        "GIT_USERNAME": "vfn-ocode-tl",
        "GIT_EMAIL": "vfn-ocode-tl@vectorflownetwork.com",
        "GIT_SIGN_COMMITS": "false",
        "GIT_CONFIG_GLOBAL": "/home/agent/.gitconfig.d/vfn-ocode-tl.conf"
      }
    },
    "gitlab_tl": {
      "command": "npx",
      "args": ["-y", "@zereight/mcp-gitlab"],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${GITLAB_TOKEN_TL}",
        "GITLAB_API_URL": "${GITLAB_API_URL}"
      }
    }
  }
}
